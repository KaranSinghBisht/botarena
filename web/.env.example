# ── BOTARENA spectator UI · public chain-reader config ──────────────
# All vars are NEXT_PUBLIC_ (read client-side); none are secret.

# JSON-RPC endpoint for BOT Chain testnet
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life

# Chain id (BOT Chain testnet = 968)
NEXT_PUBLIC_CHAIN_ID=968

# Deployed PokerTable contract address (required — no default)
NEXT_PUBLIC_TABLE_ADDRESS=

# Block explorer base URL (tx/address links)
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# First block to scan for event logs (set to the table's deploy block)
NEXT_PUBLIC_START_BLOCK=0
